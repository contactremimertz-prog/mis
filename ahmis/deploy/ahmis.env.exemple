# ------------------------------------------------------------------
# AHMIS – fichier de configuration (copié en ahmis.env par l'installeur)
# Les lignes commençant par # sont des commentaires.
# Redémarrer le service AHMIS après toute modification.
# ------------------------------------------------------------------

# --- Sécurité (obligatoire) ---
AHMIS_DEBUG=0
# Clé secrète longue et aléatoire, générée par l'installeur. Ne jamais la partager.
AHMIS_SECRET_KEY=a-remplacer
# Noms et adresses IP par lesquels les utilisateurs accèdent au serveur (séparés par des virgules)
AHMIS_ALLOWED_HOSTS=localhost,127.0.0.1,ahmis.mon-domaine.local
# Adresses complètes autorisées pour les formulaires (avec http:// ou https:// et le port s'il n'est pas standard)
AHMIS_CSRF_TRUSTED_ORIGINS=http://ahmis.mon-domaine.local
# Mettre 1 si l'accès se fait en HTTPS (certificat sur nginx / IIS / proxy)
AHMIS_HTTPS=0

# --- Données ---
# Dossier contenant la base SQLite, les pièces jointes (certificats scannés) et les journaux
AHMIS_DATA_DIR=/var/lib/ahmis

# --- Base de données (SQLite par défaut) ---
AHMIS_DB_ENGINE=sqlite
# Pour PostgreSQL :
# AHMIS_DB_ENGINE=postgresql
# AHMIS_DB_NAME=ahmis
# AHMIS_DB_USER=ahmis
# AHMIS_DB_PASSWORD=********
# AHMIS_DB_HOST=127.0.0.1
# AHMIS_DB_PORT=5432

# --- Serveur d'application ---
AHMIS_BIND=0.0.0.0:8000
AHMIS_THREADS=8

# --- Organisme (affiché sur les task cards et les CRS) ---
AHMIS_ORGANISATION=Mon organisme
AHMIS_APPROVAL_145=FR.145.XXXX
AHMIS_APPROVAL_CAMO=FR.CAMO.XXXX
AHMIS_TIME_ZONE=Europe/Paris

# --- Démonstration ---
# 1 = affiche les comptes de démonstration sur la page de connexion
AHMIS_DEMO=0

# ==================================================================
# AUTHENTIFICATION D'ENTREPRISE (voir le tutoriel 27)
# ==================================================================

# --- Groupes d'entreprise -> rôles AHMIS (commun AD et SSO) ---
# Format « groupe:rôle;groupe:rôle ». Groupe = nom (CN), DN complet ou identifiant (GUID AD / Object ID Entra).
# Rôles : Ingénieur CAMO, Planificateur, Mécanicien, Certifiant, Magasinier, Responsable qualité, admin
# AHMIS_ROLE_MAP=GG-AHMIS-CAMO:Ingénieur CAMO;GG-AHMIS-PLANIF:Planificateur;GG-AHMIS-MECA:Mécanicien;GG-AHMIS-CERT:Certifiant;GG-AHMIS-MAG:Magasinier;GG-AHMIS-QUALITE:Responsable qualité;GG-AHMIS-ADMIN:admin
# Refuser l'accès aux utilisateurs sans groupe AHMIS (recommandé)
AHMIS_AUTH_REQUIRE_ROLE=1
# 0 = seuls les comptes d'entreprise se connectent ; les superutilisateurs locaux restent possibles (secours)
AHMIS_LOCAL_LOGIN=1

# --- Active Directory (LDAP) ---
AHMIS_LDAP_ENABLED=0
# Un ou plusieurs contrôleurs de domaine, en LDAPS (port 636)
# AHMIS_LDAP_SERVERS=ldaps://dc1.corp.local,ldaps://dc2.corp.local
# AHMIS_LDAP_DOMAIN=corp.local
# AHMIS_LDAP_BASE_DN=DC=corp,DC=local
# Certificat de l'autorité de certification interne (format PEM), si non reconnu par le système
# AHMIS_LDAP_CA_FILE=/etc/ahmis/ca-interne.pem
# Attribut AD contenant le matricule (rattachement automatique à la fiche personnel)
# AHMIS_LDAP_STAFF_ATTR=employeeID
# Groupes imbriqués (groupe dans un groupe) : 1 = oui
# AHMIS_LDAP_NESTED_GROUPS=1

# --- SSO OpenID Connect ---
AHMIS_OIDC_ENABLED=0
# entra (Microsoft Entra ID / Azure AD), adfs, ou generic (Keycloak, Okta...)
# AHMIS_OIDC_PROVIDER=entra
# AHMIS_OIDC_TENANT_ID=<ID du locataire Entra>
# AHMIS_OIDC_ADFS_HOST=adfs.corp.local
# AHMIS_OIDC_CLIENT_ID=<ID d'application>
# AHMIS_OIDC_CLIENT_SECRET=<secret client>
# Pour « generic » : python manage.py ahmis_oidc_discover <issuer> affiche les lignes à ajouter
# AHMIS_OIDC_BUTTON_LABEL=Se connecter avec le compte de l'entreprise
# 1 = renvoyer directement vers le SSO (connexion locale encore possible via /connexion/?local=1)
# AHMIS_OIDC_AUTO_REDIRECT=0
# Claims contenant les groupes / rôles, et le matricule
# AHMIS_OIDC_GROUPS_CLAIMS=groups,roles
# AHMIS_OIDC_STAFF_CLAIM=employeeid
